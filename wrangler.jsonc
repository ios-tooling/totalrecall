{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "totalrecall",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },

  // Served only from the custom domain, so there is no workers.dev address to guard as well.
  // The zone must be on the same Cloudflare account; deploying creates the DNS record and certificate.
  "routes": [{ "pattern": "total-recall.stream", "custom_domain": true }],
  "workers_dev": false,

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "totalrecall",
      "database_id": "18fdca6d-8808-4e92-a04e-8981a880f027",
      "migrations_dir": "migrations"
    }
  ],

  // Session snapshots are forwarded to Chief of Staff over this binding once the
  // COS_INGEST_TOKEN secret is set; without the secret nothing is sent.
  "services": [{ "binding": "COS", "service": "chief-of-staff-ingest" }]
}
