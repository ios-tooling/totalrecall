{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "totalrecall",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },

  // Served only from the custom domain, so there is no workers.dev address to guard as well.
  // The zone must be on the same Cloudflare account; deploying creates the DNS record and certificate.
  "routes": [{ "pattern": "total-recall.stream", "custom_domain": true }],
  "workers_dev": false,

  // The review pages at /review sit behind a Cloudflare Access application on
  // total-recall.stream/review. Neither value is secret; without both, /review is closed.
  "vars": {
    "ACCESS_TEAM_DOMAIN": "proud-frog-2412.cloudflareaccess.com",
    "ACCESS_AUD": "888532b99a7c4b5122d1e2fda7c0ad16a078d4878ee0cb320c419c6c1333caf4"
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "totalrecall",
      "database_id": "18fdca6d-8808-4e92-a04e-8981a880f027",
      "migrations_dir": "migrations"
    }
  ],

  // Session snapshots are forwarded to Chief of Staff over this binding once the
  // COS_INGEST_TOKEN secret is set; without the secret nothing is sent.
  "services": [{ "binding": "COS", "service": "chief-of-staff-ingest" }]
}
